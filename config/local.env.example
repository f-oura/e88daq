# Copy to config/local/nestdaq.env (ignored by Git) and fill in the paths.
# Do not commit filled values. Do not put production IPs, MACs, or passwords here.

NESTDDAQ_PREFIX="${NESTDDAQ_PREFIX:-}"
NESTDDAQ_FETCH_DIR="${NESTDDAQ_FETCH_DIR:-}"
NESTDDAQ_SOURCE_DIR="${NESTDDAQ_SOURCE_DIR:-}"
NESTDDAQ_SOURCE_OVERLAY="${NESTDDAQ_SOURCE_OVERLAY:-}"
NESTDDAQ_USER_IMPL="${NESTDDAQ_USER_IMPL:-}"
NESTDDAQ_BUILD="${NESTDDAQ_BUILD:-}"
NESTDDAQ_USER_IMPL_BUILD="${NESTDDAQ_USER_IMPL_BUILD:-}"
NESTDDAQ_USER_IMPL_BUILD_COPY="${NESTDDAQ_USER_IMPL_BUILD_COPY:-}"
FAIRMQ_PLUGIN_PATH="${FAIRMQ_PLUGIN_PATH:-}"

# A local prefix provides redis-server/redis-cli to host-side readiness checks.
if [[ -n "${NESTDDAQ_PREFIX}" ]]; then
  PATH="${NESTDDAQ_PREFIX}/bin:${PATH}"
  LD_LIBRARY_PATH="${NESTDDAQ_PREFIX}/lib64:${NESTDDAQ_PREFIX}/lib:${LD_LIBRARY_PATH:-}"
fi

# Loopback only for mock tests. Production bind addresses stay UNBOUND.
MOCK_BIND_HOST="127.0.0.1"
MOCK_BIND_PORT="0"

# AMANEQ SiTCP endpoint. Leave UNBOUND until a controlled test net is agreed.
AMANEQ_SITCP_IP="UNBOUND"
AMANEQ_RBCP_PORT="UNBOUND"
AMANEQ_DATA_PORT="UNBOUND"
AMANEQ_NIC="UNBOUND"

# Redis used by NestDAQ run control. Do not enable remote bind in this file.
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD="UNBOUND"
