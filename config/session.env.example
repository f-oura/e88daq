# Copy to config/local/session.env (ignored by Git) for run-control/session-server.py.
# Read by bash. {run_number} and {out} in SESSION_COMMAND are filled in by the server.

# Directory with one evidence directory (daqctl --out) per session, and the session list.
SESSION_OUT_BASE=/path/to/sessions
# Directory of runXXXXXX.dat (the storage directory of the setup file).
SESSION_DATA_DIR=/path/to/data
# Where the session's daq-webctl listens (must match --webctl below).
SESSION_WEBCTL=127.0.0.1:18080
# The session itself. CTL is the work directory of amaneq/build-control-tools.sh.
SESSION_COMMAND='set -a; . config/local/nestdaq.env; set +a; CTL=/path/to/control-tools; exec python3 run-control/daqctl.py run --reader $CTL/hul-common-lib/install/bin/read_register --writer $CTL/hul-common-lib/install/bin/write_register --set-hbfstate $CTL/hul-common-lib/install/bin/set_hbfstate --run-number {run_number} --webctl 127.0.0.1:18080 --out {out}'
# To also write run<NNNNNN>_sc.dat with the SC coincidence filter (online-filter, built in build/online-filter), add to
# SESSION_COMMAND:  --sc-filter-prescale 100 --e88-param /path/to/e88param/2026nov/index.txt
